# NAWRA Backend - Production Environment Configuration
# Copy this file to .env.production and fill in your actual values
# NEVER commit the actual .env.production file to version control

# ===========================
# DATABASE CONFIGURATION
# ===========================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Alternative direct PostgreSQL connection (if not using Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/nawra

# ===========================
# JWT SECURITY
# ===========================
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your_production_secret_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# ENVIRONMENT
# ===========================
ENVIRONMENT=production
DEBUG=false
TESTING=false

# ===========================
# CORS SETTINGS
# ===========================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ===========================
# EMAIL SERVICE (Resend)
# ===========================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=NAWRA Library System

# ===========================
# CACHE (Upstash Redis - Optional)
# ===========================
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
CACHE_ENABLED=true
CACHE_TTL=3600

# ===========================
# FILE UPLOAD
# ===========================
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx
UPLOAD_DIR=/tmp/uploads

# ===========================
# MONITORING & LOGGING
# ===========================
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================
# APPLICATION SETTINGS
# ===========================
APP_NAME=NAWRA Library Management System
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# ===========================
# DEPLOYMENT
# ===========================
PORT=8000
HOST=0.0.0.0
WORKERS=4

# ===========================
# HEALTH CHECKS
# ===========================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/health

# ===========================
# BACKUP & MAINTENANCE
# ===========================
BACKUP_ENABLED=true
MAINTENANCE_MODE=false

# NAWRA Frontend - Production Environment Configuration
# Copy this file to .env.production and fill in your actual values
# NEVER commit the actual .env.production file to version control

# ===========================
# API CONFIGURATION
# ===========================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_TIMEOUT=30000

# ===========================
# SUPABASE CONFIGURATION
# ===========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================
# APPLICATION SETTINGS
# ===========================
NEXT_PUBLIC_APP_NAME=NAWRA Library Management System
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=production

# ===========================
# LOCALIZATION
# ===========================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar

# ===========================
# MONITORING & ERROR TRACKING
# ===========================
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================
# ANALYTICS (Optional)
# ===========================
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ===========================
# FEATURES FLAGS
# ===========================
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_MOBILE_APP=false

# ===========================
# CACHE & PERFORMANCE
# ===========================
NEXT_PUBLIC_CACHE_TTL=300
NEXT_PUBLIC_ENABLE_SW=true

# ===========================
# SECURITY
# ===========================
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_SECURE_COOKIES=true

# ===========================
# BUILD SETTINGS
# ===========================
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# ===========================
# DEPLOYMENT (Vercel)
# ===========================
VERCEL_ENV=production
VERCEL_URL=yourdomain.vercel.app

# ===========================
# FILE UPLOADS
# ===========================
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ===========================
# CONTACT & SUPPORT
# ===========================
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_SUPPORT_PHONE=+968-XXXXXXXX

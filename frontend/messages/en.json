    "gettingStarted": {
      "title": "Getting Started with NAWRA",
      "step1": {
        "title": "1. Log In to the System",
        "description": "Open your web browser and go to the NAWRA login page. Enter your email and password provided by your administrator.",
        "tip": "Tip: Check 'Remember me' to stay logged in for 30 days.",
        "screenshot": "Screenshot: Login page with email and password fields"
      },
      "step2": {
        "title": "2. Understand the Dashboard",
        "description": "After logging in, you'll see the Dashboard. This is your main control center showing important statistics.",
        "items": [
          "Total Users - Number of registered library users",
          "Total Books - Books in your collection",
          "Active Loans - Books currently borrowed",
          "Overdue Items - Books that need to be returned"
        ],
        "screenshot": "Screenshot: Dashboard with statistics cards"
      },
      "step3": {
        "title": "3. Navigate the Menu",
        "description": "Use the left sidebar to access different sections. Click on any menu item to open that section.",
        "menuItems": [
          "Dashboard - Overview and statistics",
          "Users - Manage library members",
          "Books - Manage book collection",
          "Circulation - Issue and return books",
          "Reports - Generate analytics reports",
          "Settings - Customize preferences"
        ],
        "screenshot": "Screenshot: Sidebar navigation menu"
      },
      "step4": {
        "title": "4. Switch Language",
        "description": "You can switch between English and Arabic anytime. Click the language button at the top right corner.",
        "tip": "Tip: The interface supports right-to-left (RTL) for Arabic language.",
        "screenshot": "Screenshot: Language switcher button"
      }
    },
    "userManagement": {
      "title": "Managing Library Users",
      "intro": "Learn how to add, edit, and manage library users in the system.",
      "step1": {
        "title": "1. View All Users",
        "description": "Click on 'Users' in the sidebar. You'll see a list of all registered users with their information.",
        "info": "You can see user name, email, role, status, and when they joined.",
        "screenshot": "Screenshot: Users list page"
      },
      "step2": {
        "title": "2. Search for a User",
        "description": "Type in the search box to find users by name, email, or ID. The results update instantly as you type.",
        "tip": "Tip: Use filters to narrow down by role, status, or user type.",
        "screenshot": "Screenshot: Search bar with filters"
      },
      "step3": {
        "title": "3. Add a New User",
        "description": "Click the 'Add User' button. Fill in the required information:",
        "fields": [
          "Full Name (in English and Arabic)",
          "Email Address",
          "Password (minimum 8 characters)",
          "Phone Number",
          "Role (Admin, Librarian, Student, etc.)",
          "User Type (Staff or Patron)"
        ],
        "action": "Click 'Create User' to save.",
        "screenshot": "Screenshot: Add user form"
      },
      "step4": {
        "title": "4. Edit User Information",
        "description": "Click the 'Edit' button next to any user. Update their information and click 'Save Changes'.",
        "tip": "Tip: Leave the password field empty if you don't want to change it.",
        "screenshot": "Screenshot: Edit user form"
      },
      "step5": {
        "title": "5. Delete a User",
        "description": "Click the 'Delete' button next to a user. Confirm the deletion when prompted.",
        "warning": "Warning: This action cannot be undone!",
        "screenshot": "Screenshot: Delete confirmation dialog"
      }
    },
    "bookCatalog": {
      "title": "Managing Book Catalog",
      "intro": "Learn how to organize and manage your library's book collection.",
      "step1": {
        "title": "1. Browse Books",
        "description": "Click on 'Books' in the sidebar to see all books in your library collection.",
        "info": "Each book card shows title, author, category, availability, and number of copies.",
        "screenshot": "Screenshot: Book catalog grid view"
      },
      "step2": {
        "title": "2. Search for Books",
        "description": "Use the search box to find books by title, author, or ISBN. Results appear instantly.",
        "screenshot": "Screenshot: Book search"
      },
      "step3": {
        "title": "3. Filter Books",
        "description": "Use filters to narrow down books:",
        "filters": [
          "Category (History, Literature, Poetry, etc.)",
          "Status (Available, Borrowed, Reserved)",
          "Language (English, Arabic)"
        ],
        "screenshot": "Screenshot: Filter options"
      },
      "step4": {
        "title": "4. Add a New Book",
        "description": "Click the 'Add Book' button and fill in book details:",

        "screenshot": "Screenshot: Book actions menu"
      }
    },
    "circulation": {
      "title": "Circulation Management",
      "intro": "Learn how to issue books to users and process returns.",
      "step1": {
        "title": "1. View Circulation Records",
        "description": "Click on 'Circulation' in the sidebar to see all active loans and returns.",

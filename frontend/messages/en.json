          "Title (English and Arabic)",
          "Author name",
          "ISBN number",
          "Category",
          "Number of copies",
          "Publication year",
          "Description"
        ],
        "screenshot": "Screenshot: Add book form"
      },
      "step5": {
        "title": "5. Edit or Delete Books",

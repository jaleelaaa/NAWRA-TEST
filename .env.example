# =====================================================
# NAWRA Library Management System - Environment Variables
# Copy this file to .env and fill in your actual values
# =====================================================

# Supabase Settings (Get from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Database Settings (Supabase PostgreSQL Connection String)
# Get from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Security Settings (IMPORTANT: Generate a strong secret key!)
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32

# Email Settings (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@nawra-library.om

# Redis Settings (Optional - for caching)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
